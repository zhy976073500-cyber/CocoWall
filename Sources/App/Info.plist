<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>CocoWall</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- run #176：App Group 编译期常量（worse_query 路线）。
	     运行时解析顺序：ALTAppGroups → 本键 → 字面量兜底
	     group.com.coco.cocowall.shared。Group id 以开发者后台
	     注册为准，本键须与 entitlements 里的声明一致。 -->
	<key>CWAppGroupIdentifier</key>
	<string>group.com.coco.cocowall.shared</string>
	<!-- 外部回环回调（run #167）：LocalDevVPN 的 URL scheme API
	     支持 `localdevvpn://enable?scheme=<回调 scheme>`，1 秒后
	     打开 `<回调 scheme>://` 跳回调用方；CocoWall 注册
	     `cocowall` 作为自己的回调 scheme，AirCardApp 的
	     onOpenURL 经 IntakeRouter.handleOpenInURL 拦截后只刷新
	     网络状态，不走文件接收。 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.coco.cocowall</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cocowall</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>localdevvpn</string>
		<string>prefs</string>
		<string>app-prefs</string>
		<string>App-prefs</string>
		<string>App-Prefs</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Live Activities: pairing progress on Dynamic Island / lock screen -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Local Network: RPPairing host + loopback tunnel -->
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing-pairable-host._tcp</string>
		<string>_aircardprobe._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CocoWall 在本机广播配对服务，让这台 iPhone 与自己配对，并连接本机 lockdown 守护进程执行写入操作。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>CocoWall 需要访问相册，以制作和应用密码盘主题的按键图片。</string>
	<!-- Background: audio keeps the app alive while the user approves the PIN -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>密码盘主题</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.aircard.passthm</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>配对文件</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.property-list</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PosterBoard 壁纸</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.aircard.tendies</string>
			</array>
		</dict>
		<!-- 统一智能接收（run #165）：Base64 编码的壁纸包以
		     .txt 形式经 UC 网盘分发，声明 public.plain-text
		     让 CocoWall 出现在文本文件的「打开方式」里，
		     导入后由 IntakeRouter 按内容解码识别。
		     Alternate 排名：不抢文本文件的默认打开者。 -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>文本文件</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aircard.passthm</string>
			<key>UTTypeDescription</key>
			<string>密码盘主题包</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>passthm</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aircard.tendies</string>
			<key>UTTypeDescription</key>
			<string>PosterBoard 壁纸包</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tendies</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aircard.tendies</string>
			<key>UTTypeDescription</key>
			<string>PosterBoard 壁纸包</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tendies</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aircard.passthm</string>
			<key>UTTypeDescription</key>
			<string>密码盘主题包</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>passthm</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
